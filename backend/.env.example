APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./dev.db
STORAGE_BACKEND=local
STORAGE_ROOT=./data
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pqc-storage
S3_BUCKET=
S3_REGION=
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=15
# In the unified docker-compose setup both services share one origin (port 80),
# so CORS is not needed between them. Keep localhost:5173 for local dev without Docker.
CORS_ORIGINS=http://localhost:80,http://localhost:5173
MAX_UPLOAD_BYTES=524288000
ALLOWED_KEMS=ML-KEM-512,ML-KEM-768,ML-KEM-1024
ALLOWED_SIGS=ML-DSA-44,ML-DSA-65,ML-DSA-87,Falcon-512,Falcon-1024,SLH-DSA-SHA2-128f,SLH-DSA-SHA2-128s
DEFAULT_KEM=ML-KEM-768
DEFAULT_SIG=ML-DSA-65
CHUNK_SIZE=4194304
AUTH_CHALLENGE_TTL_SECONDS=60
