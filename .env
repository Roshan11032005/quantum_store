# ============================================================
#  QuantumStore — root environment file
#  Copy to .env and edit before running: cp .env.example .env
#  Then start everything with:  docker compose up --build
# ============================================================

# ── Gateway ─────────────────────────────────────────────────
# Public port.  http://localhost:${GATEWAY_PORT}  is the only URL
# you need — it serves the UI AND the API with no CORS issues.
GATEWAY_PORT=80

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pqc_storage

# ── MinIO (S3-compatible object store) ──────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pqc-storage

# ── Backend app ──────────────────────────────────────────────
APP_ENV=dev
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=15
STORAGE_BACKEND=minio
MAX_UPLOAD_BYTES=524288000

# PQ algorithm allow-lists
ALLOWED_KEMS=ML-KEM-512,ML-KEM-768,ML-KEM-1024
ALLOWED_SIGS=ML-DSA-44,ML-DSA-65,ML-DSA-87,Falcon-512,Falcon-1024,SLH-DSA-SHA2-128f,SLH-DSA-SHA2-128s
DEFAULT_KEM=ML-KEM-768
DEFAULT_SIG=ML-DSA-65

CHUNK_SIZE=4194304
AUTH_CHALLENGE_TTL_SECONDS=60
